# Copie este archivo como ".env" y cambie los valores. El archivo .env NO debe subirse a git.

# Puerto del equipo por el que se entra a la app: http://NOMBRE-O-IP-DEL-EQUIPO:8000
PUERTO=8000

# Primer administrador. Solo se usa la primera vez, cuando todavía no existe ningún usuario.
ADMIN_USUARIO=admin
ADMIN_NOMBRE=Administrador
# Obligatoria: escriba una clave propia de 12 caracteres o más. Si queda vacía, no se crea el administrador.
ADMIN_CLAVE=

# Clave que firma las sesiones. Póngale un texto largo y al azar (40 caracteres o más) y no lo cambie
# después: al cambiarlo se cierran todas las sesiones. Para generar uno:
#   docker compose run --rm app python -c "import secrets; print(secrets.token_urlsafe(48))"
CLAVE_SESION=

# true solo si la app se sirve por HTTPS (detrás de un proxy). En red local por HTTP déjelo en false.
COOKIE_SEGURA=false

# Zona horaria y hora de la tarea diaria (respaldo + revisión de alarmas), formato HH:MM de 24 horas.
ZONA_HORARIA=America/Guayaquil
HORA_TAREA_DIARIA=07:00

# Facturas, panel de pagos, alarmas de vencimiento y archivo de pago masivo. Apagado por ahora: solo se
# registran proveedores. El código no se borra; para volver a usarlo ponga true y ejecute "docker compose up -d".
FACTURACION_ACTIVA=false

# Tarea diaria (respaldo + alarmas) dentro de la app. Déjela en true; solo se apaga para pruebas.
TAREAS_ACTIVAS=true

# Cuántos respaldos diarios conservar.
RESPALDOS_CONSERVAR=30

# Envío del resumen de alarmas por correo. Apagado por defecto.
CORREO_ACTIVO=false
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_TLS=true
CORREO_REMITENTE=
# Uno o varios destinatarios separados por coma.
CORREO_DESTINATARIOS=
